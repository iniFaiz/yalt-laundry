meta {
  name: Login Password Salah
  type: http
  seq: 4
}

post {
  url: {{base_url}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

params:query {
  grant_type: password
}

headers {
  apikey: {{publishable_key}}
}

body:json {
  {
    "email": "{{customer_a_phone}}@yalt.test",
    "password": "salah-password"
  }
}

tests {
  test("HTTP 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("error invalid_credentials", function() {
    expect(res.getBody().error_code).to.equal("invalid_credentials");
  });
}
