meta {
  name: Login Pelanggan B
  type: http
  seq: 3
}

post {
  url: {{base_url}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

params:query {
  grant_type: password
}

headers {
  apikey: {{publishable_key}}
}

body:json {
  {
    "email": "{{customer_b_phone}}@yalt.test",
    "password": "{{demo_password}}"
  }
}

script:post-response {
  bru.setVar("customer_b_token", res.getBody().access_token);
  bru.setVar("customer_b_id", res.getBody().user.id);
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("menerima access_token JWT", function() {
    expect(res.getBody().access_token).to.be.a("string");
  });
}
