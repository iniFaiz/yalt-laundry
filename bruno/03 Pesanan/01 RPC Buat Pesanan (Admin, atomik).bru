meta {
  name: RPC Buat Pesanan (Admin, atomik)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/rest/v1/rpc/sp_create_order
  body: json
  auth: bearer
}

headers {
  apikey: {{publishable_key}}
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "p_customer_id": "{{customer_a_id}}",
    "p_items": [
      { "service_id": "{{service_id}}", "weight_kg": 2.5 },
      { "service_id": "{{service_id}}", "weight_kg": 1 }
    ],
    "p_notes": "Dibuat dari Bruno"
  }
}

script:post-response {
  bru.setVar("order_id", res.getBody().id);
  bru.setVar("order_code", res.getBody().order_code);
  console.log("ORDER_ID=" + res.getBody().id + " ORDER_CODE=" + res.getBody().order_code);
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("status awal diterima", function() {
    expect(res.getBody().status).to.equal("diterima");
  });
  test("total = fn_item_total(2.5) + fn_item_total(1) dengan snapshot tarif", function() {
    const p = Number(bru.getVar("service_price"));
    expect(Number(res.getBody().total_amount)).to.equal(Math.round(2.5 * p) + Math.round(1 * p));
  });
  test("token QR tidak ikut dikirim ke admin", function() {
    expect(res.getBody()).to.not.have.property("pickup_token");
  });
}
