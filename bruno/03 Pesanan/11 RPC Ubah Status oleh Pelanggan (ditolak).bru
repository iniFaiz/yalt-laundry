meta {
  name: RPC Ubah Status oleh Pelanggan (ditolak)
  type: http
  seq: 11
}

post {
  url: {{base_url}}/rest/v1/rpc/sp_update_order_status
  body: json
  auth: bearer
}

headers {
  apikey: {{publishable_key}}
}

auth:bearer {
  token: {{customer_a_token}}
}

body:json {
  {
    "p_order_id": "{{order_id}}",
    "p_new_status": "dicuci"
  }
}

tests {
  test("HTTP 403", function() {
    expect(res.getStatus()).to.equal(403);
  });
  test("kode error 42501", function() {
    expect(res.getBody().code).to.equal("42501");
  });
}
