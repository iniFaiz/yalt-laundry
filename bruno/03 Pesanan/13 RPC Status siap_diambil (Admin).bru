meta {
  name: RPC Status siap_diambil (Admin)
  type: http
  seq: 13
}

post {
  url: {{base_url}}/rest/v1/rpc/sp_update_order_status
  body: json
  auth: bearer
}

headers {
  apikey: {{publishable_key}}
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "p_order_id": "{{order_id}}",
    "p_new_status": "siap_diambil"
  }
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("status menjadi siap_diambil", function() {
    expect(res.getBody().status).to.equal("siap_diambil");
  });
}
