meta {
  name: RPC Scan QR oleh Pelanggan (ditolak)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/rest/v1/rpc/sp_pickup_order
  body: json
  auth: bearer
}

headers {
  apikey: {{publishable_key}}
}

auth:bearer {
  token: {{customer_a_token}}
}

body:json {
  {
    "p_token": "{{pickup_token}}"
  }
}

tests {
  test("HTTP 403", function() {
    expect(res.getStatus()).to.equal(403);
  });
  test("kode error 42501", function() {
    expect(res.getBody().code).to.equal("42501");
  });
}
