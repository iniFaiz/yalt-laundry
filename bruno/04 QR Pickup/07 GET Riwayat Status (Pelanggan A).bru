meta {
  name: GET Riwayat Status (Pelanggan A)
  type: http
  seq: 7
}

get {
  url: {{base_url}}/rest/v1/orders?id=eq.{{order_id}}&select=id,order_code,customer_id,status,total_amount,estimated_completion_at,pickup_token_used_at,order_items(service_name_snapshot,weight_kg,price_per_kg_snapshot,subtotal),order_status_histories(from_status,to_status,changed_at)
  body: none
  auth: bearer
}

params:query {
  id: eq.{{order_id}}
  select: id,order_code,customer_id,status,total_amount,estimated_completion_at,pickup_token_used_at,order_items(service_name_snapshot,weight_kg,price_per_kg_snapshot,subtotal),order_status_histories(from_status,to_status,changed_at)
}

headers {
  apikey: {{publishable_key}}
}

auth:bearer {
  token: {{customer_a_token}}
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("trigger mencatat 4 langkah status berurutan", function() {
    const h = res.getBody()[0].order_status_histories.sort((a, b) => a.changed_at.localeCompare(b.changed_at));
    expect(h.map(x => x.to_status)).to.deep.equal(["diterima", "dicuci", "siap_diambil", "diambil"]);
  });
  test("pesanan selesai", function() {
    expect(res.getBody()[0].status).to.equal("diambil");
  });
}
