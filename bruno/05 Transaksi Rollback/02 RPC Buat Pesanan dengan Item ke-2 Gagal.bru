meta {
  name: RPC Buat Pesanan dengan Item ke-2 Gagal
  type: http
  seq: 2
}

post {
  url: {{base_url}}/rest/v1/rpc/sp_create_order
  body: json
  auth: bearer
}

headers {
  apikey: {{publishable_key}}
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "p_customer_id": "{{customer_a_id}}",
    "p_items": [
      { "service_id": "{{service_id}}", "weight_kg": 3 },
      { "service_id": "{{service_id}}", "weight_kg": -1 }
    ]
  }
}

tests {
  test("HTTP 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("kode error 22023", function() {
    expect(res.getBody().code).to.equal("22023");
  });
  test("hint invalid_weight", function() {
    expect(res.getBody().hint).to.equal("invalid_weight");
  });
}
