meta {
  name: POST Tambah Layanan sebagai Pelanggan (ditolak RLS)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/rest/v1/services
  body: json
  auth: bearer
}

headers {
  apikey: {{publishable_key}}
}

auth:bearer {
  token: {{customer_a_token}}
}

body:json {
  {
    "name": "Layanan Penyusup",
    "price_per_kg": 1000
  }
}

tests {
  test("HTTP 403", function() {
    expect(res.getStatus()).to.equal(403);
  });
  test("kode error 42501", function() {
    expect(res.getBody().code).to.equal("42501");
  });
}
