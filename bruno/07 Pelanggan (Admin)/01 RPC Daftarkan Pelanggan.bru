meta {
  name: RPC Daftarkan Pelanggan
  type: http
  seq: 1
}

post {
  url: {{base_url}}/rest/v1/rpc/admin_create_customer
  body: json
  auth: bearer
}

headers {
  apikey: {{publishable_key}}
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "p_full_name": "Pelanggan Bruno",
    "p_phone": "{{new_phone}}",
    "p_password": "{{demo_password}}"
  }
}

script:pre-request {
  bru.setVar("new_phone", "0899" + String(Date.now()).slice(-8));
}

script:post-response {
  bru.setVar("new_customer_id", res.getBody().id);
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("profil pelanggan dibuat", function() {
    expect(res.getBody().role).to.equal("customer");
    expect(res.getBody().phone).to.equal(bru.getVar("new_phone"));
  });
}
