meta {
  name: Login Pelanggan Baru (password awal)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

params:query {
  grant_type: password
}

headers {
  apikey: {{publishable_key}}
}

body:json {
  {
    "email": "{{new_phone}}@yalt.test",
    "password": "{{demo_password}}"
  }
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("akun baru bisa login", function() {
    expect(res.getBody().user.id).to.equal(bru.getVar("new_customer_id"));
  });
}
