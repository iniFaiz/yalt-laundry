meta {
  name: GET customer_summary_view (Pelanggan B, RLS)
  type: http
  seq: 3
}

get {
  url: {{base_url}}/rest/v1/customer_summary_view?select=id,full_name,order_count
  body: none
  auth: bearer
}

params:query {
  select: id,full_name,order_count
}

headers {
  apikey: {{publishable_key}}
}

auth:bearer {
  token: {{customer_b_token}}
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("pelanggan hanya melihat dirinya", function() {
    expect(res.getBody()).to.have.length(1);
    expect(res.getBody()[0].id).to.equal(bru.getVar("customer_b_id"));
  });
}
