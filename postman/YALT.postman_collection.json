              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rest/v1/services",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rest",
                "v1",
                "services"
              ]
            },
            "description": "Pelanggan sudah login tapi bukan admin, insert ditolak RLS (403).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tes Pelanggan\",\n  \"price_per_kg\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PATCH Sebagai Pelanggan (tidak berpengaruh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tidak ada baris yang berubah\", () => pm.expect(pm.response.json()).to.have.lengthOf(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "apikey",
                "value": "{{publishable_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rest/v1/services?id=eq.{{service_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rest",
                "v1",
                "services"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "eq.{{service_id}}"
                }
              ]
            },
            "description": "RLS menyaring baris: update dari pelanggan tidak mengenai baris apa pun, respons berupa array kosong.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price_per_kg\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "DELETE Sebagai Pelanggan (tidak berpengaruh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tidak ada baris yang terhapus\", () => pm.expect(pm.response.json()).to.have.lengthOf(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "apikey",
                "value": "{{publishable_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rest/v1/services?id=eq.{{service_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rest",
                "v1",
                "services"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "eq.{{service_id}}"
                }
              ]
            },
            "description": "Pelanggan mencoba menghapus layanan: tidak ada baris yang terhapus."
          }
        }
      ]
    },
