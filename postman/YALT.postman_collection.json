{
  "info": {
    "name": "YALT - Supabase API",
    "description": "Koleksi uji API YALT (Supabase PostgREST + Auth).\n\n1. Isi variabel koleksi `base_url` dan `publishable_key` (tab Variables), lalu Save.\n2. Jalankan request berurutan dari folder 1 sampai 5, atau klik Run collection. Login menyimpan token otomatis.\n\nAkun demo: admin 081111111111, pelanggan 081234567890, password ayamgoreng.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://YOUR-PROJECT-REF.supabase.co"
    },
    {
      "key": "publishable_key",
      "value": "sb_publishable_ISI_DENGAN_KEY_KAMU"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "customer_token",
      "value": ""
    },
    {
      "key": "service_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Mengembalikan access_token\", () => pm.expect(json.access_token).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"admin_token\", json.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{publishable_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/v1/token?grant_type=password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "description": "Login Supabase Auth. Nomor HP 081111111111 dipetakan ke email internal 081111111111@yalt.test. Token disimpan otomatis ke variabel admin_token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"081111111111@yalt.test\",\n  \"password\": \"ayamgoreng\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login Pelanggan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Mengembalikan access_token\", () => pm.expect(json.access_token).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"customer_token\", json.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{publishable_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/v1/token?grant_type=password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "description": "Login Supabase Auth. Nomor HP 081234567890 dipetakan ke email internal 081234567890@yalt.test. Token disimpan otomatis ke variabel customer_token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"081234567890@yalt.test\",\n  \"password\": \"ayamgoreng\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login Password Salah",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"error_code invalid_credentials\", () => pm.expect(pm.response.json().error_code).to.eql(\"invalid_credentials\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{publishable_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/v1/token?grant_type=password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "description": "Password salah harus ditolak dengan 400 invalid_credentials.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"081111111111@yalt.test\",\n  \"password\": \"salah\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Profil Saya (Pelanggan)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "pm.test(\"Hanya 1 profil (milik sendiri)\", () => pm.expect(rows).to.have.lengthOf(1));",
                  "pm.test(\"Role customer\", () => pm.expect(rows[0].role).to.eql(\"customer\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{publishable_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rest/v1/profiles?select=id,full_name,phone,role",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rest",
                "v1",
                "profiles"
              ],
              "query": [
                {
                  "key": "select",
                  "value": "id,full_name,phone,role"
                }
              ]
            },
            "description": "RLS profiles: pelanggan hanya melihat profilnya sendiri (1 baris)."
          }
        }
      ]
    },
    {
      "name": "2. Layanan (CRUD Admin)",
      "item": [
        {
          "name": "GET Daftar Layanan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "pm.test(\"Berupa array dan tidak kosong\", () => pm.expect(rows).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"Setiap layanan punya tarif > 0\", () => rows.forEach(r => pm.expect(r.price_per_kg).to.be.above(0)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{publishable_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rest/v1/services?select=id,name,price_per_kg,is_active&order=name.asc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rest",
                "v1",
                "services"
              ],
              "query": [
                {
                  "key": "select",
                  "value": "id,name,price_per_kg,is_active"
                },
                {
                  "key": "order",
                  "value": "name.asc"
                }
              ]
            },
            "description": "Ambil semua layanan. Boleh tanpa login (data publik). Sama dengan ServiceRepository.fetchServices()."
          }
        },
        {
          "name": "POST Tambah Layanan (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const row = pm.response.json()[0];",
                  "pm.test(\"Layanan baru aktif\", () => pm.expect(row.is_active).to.eql(true));",
                  "pm.test(\"Tarif tersimpan 15000\", () => pm.expect(row.price_per_kg).to.eql(15000));",
                  "pm.collectionVariables.set(\"service_id\", row.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{publishable_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rest/v1/services",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rest",
                "v1",
                "services"
              ]
            },
            "description": "Tambah layanan sebagai admin. Sama dengan ServiceRepository.addService(). id disimpan ke variabel service_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cuci Bedcover {{$timestamp}}\",\n  \"price_per_kg\": 15000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PATCH Ubah Tarif (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tarif berubah menjadi 17500\", () => pm.expect(pm.response.json()[0].price_per_kg).to.eql(17500));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "apikey",
                "value": "{{publishable_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rest/v1/services?id=eq.{{service_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rest",
                "v1",
                "services"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "eq.{{service_id}}"
                }
              ]
            },
            "description": "Ubah tarif layanan yang baru dibuat. Sama dengan ServiceRepository.updateService(pricePerKG: ...).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price_per_kg\": 17500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PATCH Nonaktifkan Layanan (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is_active menjadi false\", () => pm.expect(pm.response.json()[0].is_active).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "apikey",
                "value": "{{publishable_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rest/v1/services?id=eq.{{service_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rest",
                "v1",
                "services"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "eq.{{service_id}}"
                }
              ]
            },
            "description": "Nonaktifkan layanan (bukan dihapus). Sama dengan switch aktif/nonaktif di aplikasi.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
